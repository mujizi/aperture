{
  "name": "aperture-attention-layer",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "A local-first attention routing layer between coding agents and humans.",
  "scripts": {
    "dev": "concurrently -k -n daemon,review -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "node plugins/aperture-attention/runtime/server.mjs",
    "build": "npm run build:web && npm run build:server && npm run validate:plugin",
    "build:mac": "scripts/build-macos-app.sh",
    "install:mac": "scripts/install-macos-app.sh",
    "restart:mac": "scripts/install-macos-app.sh",
    "package:mac": "scripts/package-macos.sh",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "setup:validator": "python3 -m venv .venv && .venv/bin/pip install pyyaml",
    "validate:plugin": ".venv/bin/python /Users/wangmengna/.codex/skills/.system/plugin-creator/scripts/validate_plugin.py plugins/aperture-attention",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/seed-demo.ts",
    "open": "node plugins/aperture-attention/scripts/open-sidecar.mjs",
    "install:plugin": "node scripts/install-plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
